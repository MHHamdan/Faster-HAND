    "code_diff": "diff --git a/hand_v2/stage1/run_patched_main.py b/hand_v2/stage1/run_patched_main.py\nindex 313d7e8..1298c35 100644\n--- a/hand_v2/stage1/run_patched_main.py\n+++ b/hand_v2/stage1/run_patched_main.py\n@@ -34,6 +34,9 @@ DAN = os.path.join(ROOT, \"third_party\", \"DAN\")\n TARGETS = {\n     \"dan_page\": {\"script\": os.path.join(DAN, \"OCR\", \"document_OCR\", \"dan\", \"main_dan.py\"),\n                  \"dataset_link\": (\"READ_2016_page_sem_dan\", os.path.join(DAN, \"Datasets\", \"formatted\", \"READ_2016_page_sem\"))},\n+    \"dan_page_textonly\": {\"script\": os.path.join(DAN, \"OCR\", \"document_OCR\", \"dan\", \"main_dan.py\"),\n+                          \"dataset_link\": (\"READ_2016_page_dan_textonly\",\n+                                           os.path.join(DAN, \"Datasets\", \"formatted\", \"READ_2016_page_dan_textonly\"))},\n     \"dan_line\": {\"script\": os.path.join(DAN, \"OCR\", \"line_OCR\", \"ctc\", \"main_line_ctc.py\"),\n                  \"dataset_link\": (\"READ_2016_page_sem_dan\", os.path.join(DAN, \"Datasets\", \"formatted\", \"READ_2016_page_sem\"))},\n     \"hand_line\": {\"script\": os.path.join(ROOT, \"hand\", \"OCR\", \"line_OCR\", \"ctc\", \"main_line_ctc_syn.py\"),\n@@ -59,10 +62,17 @@ def patch(text, a, which):\n     text = sub_once(text, r'torch\\.cuda\\.manual_seed\\(0\\)', 'torch.cuda.manual_seed({})'.format(a.seed), \"cuda seed\")\n     text = sub_once(text, r'np\\.random\\.seed\\(0\\)', 'np.random.seed({})'.format(a.seed), \"numpy seed\")\n     text = sub_once(text, r'(?<!np\\.)random\\.seed\\(0\\)', 'random.seed({})'.format(a.seed), \"python seed\")\n+    if which == \"dan_page_textonly\":\n+        # X1 reconciliation control: the ONLY training-config change against dan_page is the\n+        # dataset the run reads. Everything else (Adam 1e-4, batch 1, AMP, curriculum, synthetic\n+        # schedule, teacher forcing, 2D/1D PE, transfered_charset, additional_tokens, metrics)\n+        # is left exactly as upstream wrote it.\n+        text = sub_once(text, r'dataset_variant = \"_sem\"', 'dataset_variant = \"_dan_textonly\"',\n+                        \"dan_page_textonly dataset variant\")\n     if which == \"hand_line\":\n         # synthetic lines are rendered from the page transcriptions; use the five-token set\n         text = sub_once(text, r'dataset_level = \"page_sem\"', 'dataset_level = \"page_sem_dan\"', \"hand_line dataset level\")\n-    if which == \"dan_page\" and a.line_init:\n+    if which in (\"dan_page\", \"dan_page_textonly\") and a.line_init:\n         init = os.path.abspath(a.line_init)\n         text = sub_once(text, r'\"encoder\": \\[\"encoder\", \"[^\"]*\"', '\"encoder\": [\"encoder\", \"{}\"'.format(init), \"encoder init\")\n         text = sub_once(text, r'\"decoder\": \\[\"decoder\", \"[^\"]*\"', '\"decoder\": [\"decoder\", \"{}\"'.format(init), \"decoder init\")\n@@ -122,8 +132,10 @@ def main():\n \n     from experiments.benchmark_suite.record import RunRecord\n     rec = RunRecord.start(name=a.output, kind=\"train\", experiment=a.experiment,\n-                          dataset={\"name\": \"READ_2016\", \"level\": \"page\" if a.which == \"dan_page\" else \"line\",\n-                                   \"variant\": \"_sem\" if a.which == \"dan_page\" else \"_synthetic\", \"id\": a.which, \"path\": t[\"script\"], \"splits\": {}},\n+                          dataset={\"name\": \"READ_2016\",\n+                                   \"level\": \"page\" if a.which in (\"dan_page\", \"dan_page_textonly\") else \"line\",\n+                                   \"variant\": {\"dan_page\": \"_sem\", \"dan_page_textonly\": \"_dan_textonly\"}.get(a.which, \"_synthetic\"),\n+                                   \"id\": a.which, \"path\": t[\"script\"], \"splits\": {}},\n                           seed=a.seed, config={\"which\": a.which, \"script\": os.path.relpath(t[\"script\"], ROOT), \"patched_sha256\": sha,\n                                                \"max_epochs\": a.max_epochs, \"line_init\": a.line_init, \"fonts_dir\": a.fonts_dir, \"n_fonts\": n_fonts},\n                           notes=\"upstream entry point with patched constants; see hand_v2/stage1/run_patched_main.py\",\ndiff --git a/hand_v2/train.py b/hand_v2/train.py\nindex fad6d47..236e1a2 100644\n--- a/hand_v2/train.py\n+++ b/hand_v2/train.py\n@@ -52,6 +52,14 @@ def dataset_descriptor(a, data_path):\n def main():\n     ap = build_arg_parser()\n     ap.add_argument(\"--experiment\", default=None)\n+    # Protocol: the test split is opened ONCE, after the recipe is frozen. Diagnostic and probe\n+    # runs must not evaluate it -- see experiments/PROVENANCE_AUDIT.md section 5, where two probes\n+    # were found to have written test metrics into the registry. Test evaluation is therefore\n+    # OPT-IN: a run that reports test numbers must say so at launch, on the record.\n+    ap.add_argument(\"--eval-test\", action=\"store_true\",\n+                    help=\"evaluate the test split at the end of training. Off by default. Pass it \"\n+                         \"only for a run explicitly registered as a test evaluation; every \"\n+                         \"diagnostic, probe or screening run must leave it off.\")\n     ap.add_argument(\"--notes\", default=None)\n     ap.add_argument(\"--cudnn-api\", default=\"v7\", choices=[\"v7\", \"v8\"],\n                     help=\"v7 (default): legacy cuDNN API, no per-shape plan building. v8: \"\n@@ -147,7 +155,13 @@ def main():\n         metrics = {\"reported_checkpoint\": which, \"best_epoch\": manager.latest_epoch,\n                    \"last_epoch\": max([int(f.split(\"_\")[-1].split(\".\")[0]) for f in available if \"last\" in f] or [None]),\n                    \"eval_batch_size\": a.batch_size, \"decoding\": \"greedy\"}\n-        for split in [\"test\", \"valid\"]:\n+        eval_splits = ([\"test\", \"valid\"] if a.eval_test else [\"valid\"])\n+        metrics[\"test_evaluated\"] = bool(a.eval_test)\n+        metrics[\"protocol_note\"] = (\n+            \"test evaluated at launch request (--eval-test)\" if a.eval_test else\n+            \"TEST NOT EVALUATED -- diagnostic/screening run; test is opened once, after the \"\n+            \"recipe is frozen, by a run launched with --eval-test\")\n+        for split in eval_splits:\n             split_dir = os.path.join(data_path, split)\n             if os.path.isdir(split_dir) and os.listdir(split_dir):\n                 name = \"{}-{}\".format(a.dataset, split)",
